# Phase 1 — Auth/JWT settings
#
# Copy this file to `.env` (optional) or set these variables in your shell.
# The backend requires JWT_SECRET_KEY to issue/validate tokens.

# Required
JWT_SECRET_KEY=change-me

# Optional (defaults shown)
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Local dev bootstrap users (idempotent seed scripts)
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=AdminPass123!
DEFAULT_ADMIN_NAME=Default Admin

DEFAULT_VIEWER_EMAIL=viewer@example.com
DEFAULT_VIEWER_PASSWORD=ViewerPass123!
DEFAULT_VIEWER_NAME=Default Viewer
