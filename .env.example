# Phase 1 — Auth/JWT settings
#
# Copy this file to `.env` (optional) or set these variables in your shell.
# The backend requires JWT_SECRET_KEY to issue/validate tokens.

# Required
JWT_SECRET_KEY=change-me

# Optional (defaults shown)
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
APP_MODE=local-demo
PERSIST_DEMO_DATA=true
ENABLE_DOCS=true
FRONTEND_URL=

# Database / cache
# Local dev can omit DATABASE_URL and use SQLite automatically.
# For PostgreSQL + Redis mode:
# DATABASE_URL=postgresql://risk_user:risk_password@localhost:5432/risk_db
# REDIS_URL=redis://localhost:6379/0
DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800

# Optional demo CORS list for tunneled frontend / SDK origins.
# Comma-separated, for example:
# CORS_ALLOW_ORIGINS=https://your-frontend.ngrok-free.app,https://your-sdk.trycloudflare.com
CORS_ALLOW_ORIGINS=

# Local dev bootstrap users (idempotent seed scripts)
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=AdminPass123!
DEFAULT_ADMIN_NAME=Default Admin

DEFAULT_REVIEWER_EMAIL=reviewer@example.com
DEFAULT_REVIEWER_PASSWORD=ReviewerPass123!
DEFAULT_REVIEWER_NAME=Default Reviewer

DEFAULT_VIEWER_EMAIL=viewer@example.com
DEFAULT_VIEWER_PASSWORD=ViewerPass123!
DEFAULT_VIEWER_NAME=Default Viewer

# Controlled hosted demo admin (preferred aliases for seed_admin.py)
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=change-me-admin-password
DEMO_ADMIN_NAME=Demo Administrator
