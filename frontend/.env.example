# Frontend API origin for the reviewer console.
# Local example:
# VITE_API_BASE_URL=http://127.0.0.1:8000
# Hosted demo example:
# VITE_API_BASE_URL=https://your-demo-backend.example.com
VITE_API_BASE_URL=http://127.0.0.1:8000

# Enables candidate-facing demo storytelling toasts for meaningful integrity signals.
# Set to false to disable. Mirrors the demo flag DEMO_SIGNAL_TOASTS_ENABLED for Vite builds.
VITE_DEMO_SIGNAL_TOASTS_ENABLED=true

# Enables browser-level demo notifications for meaningful integrity signals when the assessment tab is hidden.
# Set to false to keep only in-page demo toasts.
VITE_DEMO_BROWSER_NOTIFICATIONS_ENABLED=true
